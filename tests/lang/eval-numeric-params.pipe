# Numeric parameters are evaluated once at the call, on the caller's group, in the frame the argument is written in.
(import "default")
num_type = u32
sub = (parse "(x | y) - (x & y)")
(def (with_budget n p:pipe) rewrites = n | p)
(def (c1) main | (with_budget 0 rewrite))
sub | c1 | (save r) | (print "the argument limits the rewrites:" r)
(def (c2) main | (with_budget 8 rewrite))
sub | c2 | (save r) | (print "(with_budget 8 rewrite):" r)
(def (c3) main | (with_budget none rewrite))
sub | c3 | (save r) | (print "none is an argument too:" r)
(def (f4 n p:pipe) p | (filter (n == 7)))
(def (c4) main | (f4 size rewrite))
sub | c4 | (save r) | (print "evaluated once at the call, on the caller's group:" r)
(def @inline (f5 n p:pipe) p | (filter (n == 7)))
(def (c5) main | (f5 size rewrite))
sub | c5 | (save r) | (print "also for an @inline function:" r)
(def (f6 n p) (if (n == 9) p))
(def (c6) main | (f6 (size + 2) rewrite))
sub | c6 | (save r) | (print "arithmetic in an argument:" r)
(def (f7 n p) (if (n == none) p))
(def (c7) main | (f7 (none - 1) rewrite))
sub | c7 | (save r) | (print "(none - 1) is none:" r)
(def (f8 n p) (fix n p))
(def (g8 m) (f8 (m - 1) rewrite))
(def (c8) main | (g8 1))
sub | c8 | (save r) | (print "a parameter in an argument is read in the caller's frame:" r)
(def (g9 m q) rewrite | (fix m q))
(def (h9 k r) (g9 (k + 1) r))
(def (f9 n) (h9 5 (filter (n == 7))))
(def (c9) main | (f9 size))
sub | c9 | (save r) | (print "an argument reads the frame of the function it is written in, through two calls:" r)
(def (if_small k p) (if ((size main) <= k) p))
(def (g10 q) (save u) | q | (union id (seq u)))
(def (f10 n) (if_small (n * 2) (g10 ((filter (size <= n)) | rewrite))))
(def (c10) main | (f10 7))
sub | c10 | (save r) | (print "(f10 7):" r)
(def (c11) main | (f10 3))
sub | c11 | (save r) | (print "k is 6, under the size:" r)
(def (c12) main | (f10 4))
sub | c12 | (save r) | (print "n is 4: the filter drops the input:" r)
(def @inline (lim n p:pipe) split_runs = n | p)
(def (c13) main | (lim 3 id) | (if (split_runs == 3) id none))
sub | c13 | (save r) | (print "an @inline body shares the caller's sequence:" r)
(def @inline (hold n) (save s) | (filter (size == n)))
(def (c14) main | rewrite | (hold 3) | (union id (seq s)))
sub | c14 | (save r) | (print "and its group variables:" r)
(def (c15) main | (hold 4) | (seq s))
sub | c15 | (save r) | (print "(hold 4) | (seq s):" r)
(def @inline (i16 m p) p | (filter (m == 1)))
(def (f16 n) (i16 1 (filter (n == 7))))
(def (c16) main | (f16 size))
sub | c16 | (save r) | (print "an argument of an @inline call reads the frame it is written in:" r)

# expect stderr: the argument limits the rewrites: ((x | y) - (x & y))
# expect stderr: (with_budget 8 rewrite): (x ^ y)
# expect stderr: none is an argument too: (x ^ y)
# expect stderr: evaluated once at the call, on the caller's group: (x ^ y)
# expect stderr: also for an @inline function: (x ^ y)
# expect stderr: arithmetic in an argument: (x ^ y)
# expect stderr: (none - 1) is none: (x ^ y)
# expect stderr: a parameter in an argument is read in the caller's frame: ((x | y) - (x & y))
# expect stderr: an argument reads the frame of the function it is written in, through two calls: (x ^ y)
# expect stderr: (f10 7): (x ^ y), ((x | y) - (x & y))
# expect stderr: k is 6, under the size: ((x | y) - (x & y))
# expect stderr: n is 4: the filter drops the input: ((x | y) - (x & y))
# expect stderr: an @inline body shares the caller's sequence: ((x | y) - (x & y))
# expect stderr: and its group variables: (x ^ y)
# expect stderr: (hold 4) | (seq s): ((x | y) - (x & y))
# expect stderr: an argument of an @inline call reads the frame it is written in: ((x | y) - (x & y))
# expect value: group [(Sub (Or (Var "x") (Var "y")) (And (Var "x") (Var "y")))]

# ---
(import "default")
num_type = u32
sub = (parse "(x | y) - (x & y)")
(def (f n) max_leaves = n | check_limits | rewrite)
sub | main | (f 8)

# expect error: max_leaves is at most 6
