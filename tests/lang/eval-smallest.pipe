# smallest keeps the first strictly smallest element its steps return; clear, note and take_min are its register steps.
(import "default")
num_type = u32
sub = (parse "(x | y) - (x & y)")
xor = (parse "x ^ y")
xor2 = (parse "y ^ x")
(def (f p:pipe) p | none)
(def @inline (g n) (if (n == 1) rewrite) | none)
sub | (save s1) | (smallest rewrite | none | (seq s1)) | (save r) | (print "(smallest rewrite | none | (seq s)):" r)
sub | (smallest rewrite | none) | (save r) | (print "an empty result stays empty:" r)
sub | (smallest none) | (save r) | (print "(smallest none):" r)
sub | (smallest id) | (save r) | (print "the input is not noted:" r)
sub | (save s2) | (smallest (smallest rewrite | none | (seq s2)) | none | (seq s2)) | (save r) | (print "nested: the outer one sees the inner steps:" r)
sub | (save s3) | (smallest (f rewrite) | (seq s3)) | (save r) | (print "an argument of a def is noted where it is written:" r)
sub | (save s4) | (smallest (g 1) | (seq s4)) | (save r) | (print "an @inline body is noted:" r)
xor | (clear q) | (note q)
xor2 | (take_min q) | (save r) | (print "take_min needs a strictly smaller element:" r)
(xor2 | (union id xor)) | (clear q) | (note q)
xor | (note q)
sub | (take_min q) | (save r) | (print "the first smallest is kept:" r)
sub | (take_min q) | (save r) | (print "take_min closes the register:" r)
xor | (note q) | (take_min q) | (save r) | (print "a note without clear keeps nothing:" r)
xor | (clear q) | (note q) | (clear q)
sub | (take_min q) | (save r) | (print "a clear of an open name opens another:" r)
sub | (take_min q) | (save r) | (print "and the first one stays open:" r)
both = (sub | (union id xor))
both | (smallest (save b) | rewrite | none | (seq b)) | (save r) | (print "the smallest element of a group a step returns is noted:" r)
both | (smallest time_limit = 0 | rewrite) | (save r) | (print "past the time limit note is skipped too:" r)

# expect stderr: (smallest rewrite | none | (seq s)): (x ^ y), ((x | y) - (x & y))
# expect stderr: an empty result stays empty: 
# expect stderr: (smallest none): 
# expect stderr: the input is not noted: ((x | y) - (x & y))
# expect stderr: nested: the outer one sees the inner steps: (x ^ y), ((x | y) - (x & y))
# expect stderr: an argument of a def is noted where it is written: (x ^ y), ((x | y) - (x & y))
# expect stderr: an @inline body is noted: (x ^ y), ((x | y) - (x & y))
# expect stderr: take_min needs a strictly smaller element: (y ^ x)
# expect stderr: the first smallest is kept: (y ^ x), ((x | y) - (x & y))
# expect stderr: take_min closes the register: ((x | y) - (x & y))
# expect stderr: a note without clear keeps nothing: (x ^ y)
# expect stderr: a clear of an open name opens another: ((x | y) - (x & y))
# expect stderr: and the first one stays open: (x ^ y), ((x | y) - (x & y))
# expect stderr: the smallest element of a group a step returns is noted: (x ^ y), ((x | y) - (x & y))
# expect stderr: past the time limit note is skipped too: ((x | y) - (x & y)), (x ^ y)
# expect value: group [(Sub (Or (Var "x") (Var "y")) (And (Var "x") (Var "y"))), (Xor (Var "x") (Var "y"))]
