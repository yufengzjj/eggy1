# Pipelines of the --passes functions that read, and ones that give errors or warnings.
(import "default")
(def (prepass_steps) (fix (restarts - 1) rewrite))

# ---
(import "default")
(def (prepass_steps) lowbits | prepass_steps)

# ---
(import "default")
(def (polish_steps) (polish polish_steps))

# ---
(import "default")
(def (rewrite) (again rewrite rewrite))

# ---
(import "default")
(def (simba_steps) (simba simba_steps))

# ---
(import "default")
(def (pipeline) (fix restarts (prepass prepass_steps) | egglog | (polish polish_steps)))

# ---
(import "default")
(def (prepass_steps) (egglog x))

# ---
(import "default")
(def (simba_steps) reprint)

# ---
(import "default")
(def (polish_steps) (if (mixed main) reprint))

# ---
(import "default")
(def (rewrite) (memo rewrite (regions rewrite (relate rewrite))))

# ---
(import "default")
(def (simba_steps) (peel simba_steps))

# ---
(import "default")
(extern (x g:group) group)

# expect error: extern declarations are only read from src/builtins.pipe

# ---
(import "default")
keep = 1
(extern (x g:group) group)

# expect error: extern declarations are only read from src/builtins.pipe

# ---
(import "default")
(def (pipeline) extern)

# expect error: extern declarations are only read from src/builtins.pipe

# ---
(import "default")
(def (prepass_steps) (if (nope >= 1) id))

# expect error: unknown name nope in an expression

# ---
(import "default")
(def (prepass_steps) (off nope))

# expect error: unknown off name nope

# ---
(import "default")
(def (prepass_steps) (if (mul >= x) id))

# expect error: unknown name x in an expression

# ---
(import "default")
(def (prepass_steps) (filter lt))

# expect error: unknown name lt in an expression

# ---
(import "default")
(def (prepass_steps) (filter (size <=)))

# expect error: expected an expression, found )

# ---
(import "default")
(def (prepass_steps) (rewrites = x | id))

# expect error: rewrites is a variable that holds a number, so it cannot be bound to a group: x gives a group

# ---
(import "default")
(def (prepass_steps) (save))

# expect error: save takes 2 arguments; | gives the last: (save r:group g:group) group

# ---
(import "default")
(def (prepass_steps) (scope id id))

# expect error: scope takes 2 arguments; | gives the last: (scope p:pipe g:group) group

# ---
(import "default")
(let rewrite id)

# expect error: let rewrite: rewrite is already a function (def (rewrite) ...), which only a def defines again

# ---
(import "default")
(let x id)
(let y nope)

# expect error: unknown pass nope; did you mean note?

# ---
(import "default")
(def (pipeline) undefined_name)

# expect error: unknown pass undefined_name

# ---
(import "default")
(def (prepass_steps) (time-limit 500) | rewrite)

# expect error: (time-limit N) is no longer read: write time_limit = N, or time_limit = none for no limit

# ---
(import "default")
(def (prepass_steps) time-limit)

# expect error: (time-limit N) is no longer read: write time_limit = N, or time_limit = none for no limit

# ---
(import "default")
(def (prepass_steps) (time-limit))

# expect error: (time-limit N) is no longer read: write time_limit = N, or time_limit = none for no limit

# ---
(import "default")
(def (prepass_steps) main | (if (size-x > 1) id))

# expect error: unknown name x in an expression (size-x reads as size - x: names use _, not -)

# ---
(import "default")
(def (prepass_steps) (with rewrites=8 rewrite))

# expect error: (with KEY=VALUE ... p) is no longer read: write (KEY = VALUE | ... | p), as in (rewrites = 8 | semi_leaves = 2 | rewrite); with's bit_splits=N is bit_split_budget = N

# ---
(import "default")
(let w (with semi_leaves=2 rewrite))

# expect error: (with KEY=VALUE ... p) is no longer read: write (KEY = VALUE | ... | p), as in (rewrites = 8 | semi_leaves = 2 | rewrite); with's bit_splits=N is bit_split_budget = N

# ---
(import "default")
(def (pipeline) (if true id))

# expect error: true is no longer a condition: write 1, or (any 1) for true only on a group that is not empty

# ---
(import "default")
(def (prepass_steps) rewrite | time_limit = 100)

# expect warning: prepass_steps: time_limit = 100 ends its sequence and changes nothing

# ---
(import "default")
(def (prepass_steps) rewrite | (if (mixed main) time_limit = 100) | (relate rewrite))

# ---
(import "default")
(def (prepass_steps) (on nope))

# expect error: unknown on name nope

# ---
(import "default")
(def (prepass_steps) (on))

# expect error: on needs a pass name

# ---
(import "default")
(def (prepass_steps) on/relate)

# expect error: write on/relate as (on relate)

# ---
(import "default")
(def (prepass_steps) rewrite | (scope (rewrites = 8 | (off relate))) | (off cut) | lowbits)

# expect warning: prepass_steps: (off relate) ends its sequence and changes nothing

# ---
(import "default")
(def (prepass_steps) save/t)

# expect error: write save/t as (save t)

# ---
(import "default")
(def (pipeline) nope)

# expect error: unknown pass nope; did you mean note?

# ---
(import "default")
(def (pipeline) (best x rewrite))

# expect error: unknown name x in an expression

# ---
(import "default")
(def (pipeline) (fix 2 a b))

# expect error: unknown pass a

# ---
(import "default")
(def (pipeline) (loop rewrite))

# expect error: unknown pass loop

# ---
(import "default")
(def (pipeline) (fix many id))

# expect error: unknown name many in an expression; did you mean any?

# ---
(import "default")
(def (pipeline) (if nope id))

# expect error: unknown name nope in an expression

# ---
(import "default")
(def (pipeline) (if mixed id id id))

# expect error: if takes 3 or 4 arguments; | gives the last: (if c:group->num a:pipe b:pipe? g:group) group

# ---
(import "default")
(def (pipeline) (retry mixed id))

# expect error: retry takes 4 arguments; | gives the last: (retry c:group->num a:pipe b:pipe g:group) group
