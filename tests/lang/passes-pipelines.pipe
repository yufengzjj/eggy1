# Pipelines of the --passes functions that read, and ones that give errors or warnings.
(import "default")
(def (prepass_steps) (fix (restarts - 1) rewrite))

# ---
(import "default")
(def (prepass_steps) lowbits | prepass_steps)

# ---
(import "default")
(def (polish_steps) (polish polish_steps))

# ---
