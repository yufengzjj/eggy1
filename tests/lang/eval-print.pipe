# print writes numbers, none, variables, group variables in infix, names and function signatures; assert passes its input on.
(import "default")
x3 = (parse "x + 253")
r = (x3 | main | (assert (size == 3) "three"))
(print r)

# expect stderr: (x + 0xfd)
# expect value: group []

# ---
(import "default")
num_type = u8
x3 = (parse "x + 253")
r = (x3 | main | (save t) | (print "size" size none max_leaves (size * 2) t rewrite some_name) | (print t))
(print "print passes the group on:" r)

# expect stderr: size 3 none 6 6 (x + 0xfd) (rewrite g:group) group some_name
# expect stderr: (x + 0xfd)
# expect stderr: print passes the group on: (x + 0xfd)
# expect value: group []

# ---
(import "default")
num_type = i8
x3 = (parse "x + 253")
x3 | main | (save t) | (print t)

# expect stderr: (x - 3)
# expect value: group [(Add (Var "x") (Num 253))]

# ---
(import "default")
two = (parse "(x & y) + (x | y)")
two | main | (union id rewrite) | (save u) | (print u)

# expect stderr: ((x & y) + (x | y)), (x + y)
# expect value: group [(Add (And (Var "x") (Var "y")) (Or (Var "x") (Var "y"))), (Add (Var "x") (Var "y"))]

# ---
(import "default")
(def (g) id)
x3 = (parse "x + 253")
x3 | main | f:term->num = size | (print f g) | g

# expect stderr: f:term->num (g g:group) group
# expect value: group [(Add (Var "x") (Num 253))]

# ---
(import "default")
(let l rewrite | lowbits)
(def @inline (k p:pipe) p | rewrite)
x3 = (parse "x + 253")
x3 | main | (print fix l k rewrite)

# expect stderr: (fix n:num p:pipe g:group) group (l g:group) group (k p:pipe g:group) group (rewrite g:group) group
# expect value: group [(Add (Var "x") (Num 253))]

# ---
(import "default")
x3 = (parse "x + 253")
x3 | main | (save t) | (print t) | (assert (size (main t)) "m")

# expect stderr: (x + 0xfd)
# expect value: group [(Add (Var "x") (Num 253))]
