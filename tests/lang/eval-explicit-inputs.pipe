# Explicit inputs: | fills in the input, a value or pipeline written as the input, function values called as (p g), number functions on the step's input.
(import "default")
num_type = u32
sub = (parse "(x | y) - (x & y)")
(def (f p:pipe g:group) g | p)
(def (c1) main | (f rewrite))
sub | c1 | (save r) | (print "| fills in the input:" r)
(def (c2) main | rewrite | (save t) | none | ((f id t) | id))
sub | c2 | (save r) | (print "an explicit input:" r)
(def (c3) main | rewrite | (save t) | none | (t | (f id)))
sub | c3 | (save r) | (print "a pipeline starting with a value:" r)
(def (f4 p:pipe g) g | p | rewrite)
(def (c4) main | (f4 id))
(def (c4b) main | rewrite)
sub | c4 | (save r) | (print "an input the body starts from:" r)
sub | c4b | (save r) | (print "main | rewrite:" r)
(def (f5 g) g | rewrite)
(def (c5) main | (union id rewrite) | (f5))
(def (c5b) main | (union id rewrite) | rewrite)
sub | c5 | (save r) | (print "a term input runs on each element:" r)
sub | c5b | (save r) | (print "(union id rewrite) | rewrite:" r)
(def (f6 t:term p) t | p | (best 1 p))
(def (c6) main | rewrite | (save t) | none | ((f6 (main t) id) | id))
sub | c6 | (save r) | (print "a term argument:" r)
(def (h7 g) g | size)
(def (c7) main | x = (h7 main) | (if (x == (size main) && ((h7 main) < 100)) rewrite))
sub | c7 | (save r) | (print "a term input written in an expression:" r)
(def (k8 g:group) (size (main g)))
(def (c8) main | (save t) | (if ((k8 t) == (size main) && ((k8 main) < 100)) rewrite))
sub | c8 | (save r) | (print "a group input written in an expression:" r)
(def (twice p g) (p (p g)))
(def (c9) main | (save t) | u = (twice rewrite t) | (seq u))
sub | c9 | (save r) | (print "a function value called as (p g):" r)
(def (c10) main | (save t) | none | (twice rewrite t))
sub | c10 | (save r) | (print "a call with its input written gives its value, the value before is dropped:" r)
(def (big k g:group) (size (main g)) > k)
(def (c11) main | (if (big 5) rewrite))
sub | c11 | (save r) | (print "a function giving a number, its input the step's:" r)
(def (c12) main | (if (big 9) rewrite))
sub | c12 | (save r) | (print "(if (big 9) rewrite):" r)
(def (c13) main | rewrite | (save t) | none | (if (big 2 t) (seq t)))
sub | c13 | (save r) | (print "its input written:" r)
(def (c14) main | (filter (big 9)))
sub | c14 | (save r) | (print "(filter (big 9)):" r)
(def (m15 g:group) (mixed (main g)) || (size (main g)) > 100)
(def (c15) main | (if (m15) rewrite))
sub | c15 | (save r) | (print "(if (m15) rewrite):" r)
(def (k16 n:num) split_runs = n | (if (split_runs == 3) rewrite))
(def (c16) main | (k16 3))
sub | c16 | (save r) | (print "an annotated parameter:" r)
(def (c17) main | (f rewrite (lowbits | unshift)))
sub | c17 | (save r) | (print "an input that is a pipeline on the step's input:" r)
(def (h18 a:group) (f id a))
(def (c18) main | rewrite | (save t) | none | u = (h18 t) | (seq u))
sub | c18 | (save r) | (print "a group parameter as an input:" r)
(def (c19) main | (if ((size (main (rewrite))) < size) rewrite))
sub | c19 | (save r) | (print "an input of a number function:" r)
(def @inline (k20 p:pipe g:group) g | p | (union id g))
(def (c20) main | (k20 rewrite))
sub | c20 | (save r) | (print "@inline with an input: bound in the caller's group variables:" r)
(def (c21) main | (k20 (k20 rewrite)))
sub | c21 | (save r) | (print "each call binds its own:" r)
(def (c22) main | rewrite | (save t) | none | ((k20 id t) | id))
sub | c22 | (save r) | (print "an explicit input:" r)
(def @inline (k23 g:group) g | (save u))
(def (c23) main | rewrite | k23 | none | (seq u))
sub | c23 | (save r) | (print "it shares the caller's group variables:" r)

# expect stderr: | fills in the input: (x ^ y)
# expect stderr: an explicit input: (x ^ y)
# expect stderr: a pipeline starting with a value: (x ^ y)
# expect stderr: an input the body starts from: (x ^ y)
# expect stderr: main | rewrite: (x ^ y)
# expect stderr: a term input runs on each element: (x ^ y)
# expect stderr: (union id rewrite) | rewrite: (x ^ y)
# expect stderr: a term argument: (x ^ y)
# expect stderr: a term input written in an expression: (x ^ y)
# expect stderr: a group input written in an expression: (x ^ y)
# expect stderr: a function value called as (p g): (x ^ y)
# expect stderr: a call with its input written gives its value, the value before is dropped: (x ^ y)
# expect stderr: a function giving a number, its input the step's: (x ^ y)
# expect stderr: (if (big 9) rewrite): ((x | y) - (x & y))
# expect stderr: its input written: (x ^ y)
# expect stderr: (filter (big 9)): 
# expect stderr: (if (m15) rewrite): ((x | y) - (x & y))
# expect stderr: an annotated parameter: (x ^ y)
# expect stderr: an input that is a pipeline on the step's input: (x ^ y)
# expect stderr: a group parameter as an input: (x ^ y)
# expect stderr: an input of a number function: (x ^ y)
# expect stderr: @inline with an input: bound in the caller's group variables: (x ^ y), ((x | y) - (x & y))
# expect stderr: each call binds its own: (x ^ y), ((x | y) - (x & y))
# expect stderr: an explicit input: (x ^ y)
# expect stderr: it shares the caller's group variables: (x ^ y)
# expect warning: c2: (t | (f id)) | id does not use its input; the value of the step before is dropped
# expect warning: c3: t | (f id) does not use its input; the value of the step before is dropped
# expect warning: c6: (f6 (main t) id) | id does not use its input; the value of the step before is dropped
# expect warning: c10: t | (twice rewrite) does not use its input; the value of the step before is dropped
# expect warning: c18: (seq u) does not use its input; the value of the step before is dropped
# expect warning: c22: t | (k20 id) | id does not use its input; the value of the step before is dropped
# expect warning: c23: (seq u) does not use its input; the value of the step before is dropped
# expect value: group [(Xor (Var "x") (Var "y"))]

# ---
(import "default")
(def (twice p g) (p (p g)))
(def (prepass_steps) (save t) | (twice rewrite t))
