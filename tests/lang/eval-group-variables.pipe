# Group variables: R = p binds p's result and passes the input on, its right side a scope; defs bind their own, arguments and @inline the caller's.
(import "default")
num_type = u32
sub = (parse "(x | y) - (x & y)")
(def (c1) main | t = (lowbits | unshift) | (filter (size == (size (main t)))) | (seq t))
sub | c1 | (save r) | (print "t = (lowbits | unshift):" r)
(def (c2) main | t = rewrite)
sub | c2 | (save r) | (print "the input passes on:" r)
(def (c3) main | t = rewrite | (seq t))
sub | c3 | (save r) | (print "t = rewrite | (seq t):" r)
(def (c4) main | t = rewrite | (filter (size > (size (main t)) && !(same (main t)))))
sub | c4 | (save r) | (print "t = rewrite | (filter ...):" r)
(def (c5a) main | rewrite | t = id | none | (seq t))
(def (c5b) main | rewrite | (save t) | none | (seq t))
sub | c5a | (save r) | (print "(save t) is t = id:" r)
sub | c5b | (save r) | (print "(save t) is t = id:" r)
(def (c6) main | t = (relate = 0 | rewrite) | t = (union (seq t) id) | (seq t))
sub | c6 | (save r) | (print "t = (union (seq t) id):" r)
(def (f7) t = rewrite | (seq t))
(def (c7) main | t = id | f7 | none | (seq t))
sub | c7 | (save r) | (print "a def binds its own group variables:" r)
(def (f8) rewrite)
(def (c8) main | t = f8 | (seq t))
sub | c8 | (save r) | (print "t = f8:" r)
(def (f9 p:pipe) p | none)
(def (c9) main | (f9 t = rewrite) | (seq t))
sub | c9 | (save r) | (print "an argument binds the caller's:" r)
(def (f10 r:group p:pipe) u = (r | p) | (seq u))
(def (c10) main | (save t) | (f10 t rewrite))
sub | c10 | (save r) | (print "a group parameter as a value:" r)
(def @inline (g11 p) u = p)
(def (c11) main | (g11 rewrite) | (seq u))
sub | c11 | (save r) | (print "an @inline function binds the caller's:" r)
(def (c12) main | (smallest t = rewrite))
sub | c12 | (save r) | (print "smallest notes the steps of a right side:" r)
(def (c13) main | time_limit = 0 | t = rewrite | (seq t))
sub | c13 | (save r) | (print "past the limit the right side's steps are skipped:" r)
(def (c14) main | rewrite | t = id | u = t | none | (seq u))
sub | c14 | (save r) | (print "a group variable on the right side:" r)
(def (f15 r) u = r | (seq u))
(def (c15) main | rewrite | (save t) | (f15 t))
sub | c15 | (save r) | (print "(f15 t):" r)
(def (c16) main | t = (off tfunc) | tfunc)
sub | c16 | (save r) | (print "the right side is a scope:" r)
(def (c17) main | (off tfunc) | tfunc)
sub | c17 | (save r) | (print "(off tfunc) | tfunc:" r)
(def (c18) main | t = (split_runs = 3 | id) | (if (split_runs == 3) none))
sub | c18 | (save r) | (print "t = (split_runs = 3 | id):" r)

# expect stderr: t = (lowbits | unshift): ((x | y) - (x & y))
# expect stderr: the input passes on: ((x | y) - (x & y))
# expect stderr: t = rewrite | (seq t): (x ^ y)
# expect stderr: t = rewrite | (filter ...): ((x | y) - (x & y))
# expect stderr: (save t) is t = id: (x ^ y)
# expect stderr: (save t) is t = id: (x ^ y)
# expect stderr: t = (union (seq t) id): (x ^ y), ((x | y) - (x & y))
# expect stderr: a def binds its own group variables: ((x | y) - (x & y))
# expect stderr: t = f8: (x ^ y)
# expect stderr: an argument binds the caller's: (x ^ y)
# expect stderr: a group parameter as a value: (x ^ y)
# expect stderr: an @inline function binds the caller's: (x ^ y)
# expect stderr: smallest notes the steps of a right side: (x ^ y), ((x | y) - (x & y))
# expect stderr: past the limit the right side's steps are skipped: ((x | y) - (x & y))
# expect stderr: a group variable on the right side: (x ^ y)
# expect stderr: (f15 t): (x ^ y)
# expect stderr: the right side is a scope: (x ^ y)
# expect stderr: (off tfunc) | tfunc: ((x | y) - (x & y))
# expect stderr: t = (split_runs = 3 | id): ((x | y) - (x & y))
# expect warning: c2: group variable t is bound and never read
# expect warning: c12: group variable t is bound and never read
# expect warning: c16: group variable t is bound and never read
# expect warning: c16: (off tfunc) ends its sequence and changes nothing
# expect warning: c18: group variable t is bound and never read
# expect value: group [(Sub (Or (Var "x") (Var "y")) (And (Var "x") (Var "y")))]
