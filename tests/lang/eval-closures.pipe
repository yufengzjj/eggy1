# Pipeline arguments are closures: they read and write the caller's group variables, run where they are called.
(import "default")
num_type = u32
sub = (parse "(x | y) - (x & y)")
(def (f1 p) (save t) | p | (union id (seq t)))
(def (c1) main | (save t) | rewrite | (f1 (seq t)))
sub | c1 | (save r) | (print "the argument reads the caller's group variable, the body its own:" r)
(def (f2 p:pipe) p | none)
(def (c2) main | rewrite | (f2 (save s)) | (seq s))
sub | c2 | (save r) | (print "and writes the caller's:" r)
(def (g3 q:pipe) (save u) | none | q)
(def (h3 p) (save u) | none | (g3 (union (seq u) p)))
(def (c3) main | (save t) | rewrite | (h3 (seq t)))
sub | c3 | (save r) | (print "a parameter in an argument is the enclosing call's argument:" r)
(def (f4 r:group p:pipe) p | (seq r))
(def (c4) main | rewrite | (save t) | (f4 t none))
sub | c4 | (save r) | (print "a group parameter is the caller's group, by value:" r)
(def (without n p:pipe) (off n) | p)
(def (c5) main | (without tfunc tfunc))
sub | c5 | (save r) | (print "a name parameter as a switch:" r)
(def (c6) main | tfunc)
sub | c6 | (save r) | (print "main | tfunc:" r)
(def @inline (g7 r:group p:pipe) p | (seq r))
(def (c7) main | rewrite | (save s) | (g7 s none))
sub | c7 | (save r) | (print "an @inline function shares the caller's group variables:" r)
(def @inline (g8 p:pipe) split_runs = 3 | p)
(def (c8) main | (g8 id) | (if (split_runs == 3) id none))
sub | c8 | (save r) | (print "and its sequence:" r)
(def (g9 p:pipe) split_runs = 3 | p)
(def (c9) main | (g9 id) | (if (split_runs == 3) id none))
sub | c9 | (save r) | (print "a def's assignment ends with its run:" r)
(def (w p:pipe) (save s) | (smallest p | (seq s)))
(def (c10) main | (w rewrite))
sub | c10 | (save r) | (print "a smallest in a def body notes what a parameter's argument returns:" r)

# expect stderr: the argument reads the caller's group variable, the body its own: ((x | y) - (x & y)), (x ^ y)
# expect stderr: and writes the caller's: (x ^ y)
# expect stderr: a parameter in an argument is the enclosing call's argument: (x ^ y), ((x | y) - (x & y))
# expect stderr: a group parameter is the caller's group, by value: (x ^ y)
# expect stderr: a name parameter as a switch: ((x | y) - (x & y))
# expect stderr: main | tfunc: (x ^ y)
# expect stderr: an @inline function shares the caller's group variables: (x ^ y)
# expect stderr: and its sequence: ((x | y) - (x & y))
# expect stderr: a def's assignment ends with its run: 
# expect stderr: a smallest in a def body notes what a parameter's argument returns: (x ^ y), ((x | y) - (x & y))
# expect warning: g3: group variable u is bound and never read
# expect value: group [(Xor (Var "x") (Var "y")), (Sub (Or (Var "x") (Var "y")) (And (Var "x") (Var "y")))]
