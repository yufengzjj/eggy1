# Written parameter types, function types and group parameters, printed as the signature.
(import "default")
(def (f p:group->group) p | lowbits)
(print f)

# expect stderr: (f p:pipe g:group) group

# ---
(import "default")
(def (f p:group -> group) (best 1 p))
(print f)

# expect stderr: (f p:pipe g:group) group

# ---
(import "default")
(def (f r:group) u = r | (u | id))
(print f)

# expect stderr: (f r:group g:group) group

# ---
(import "default")
(def (f a:group p:pipe) p | (a | id))
(print f)

# expect stderr: (f a:group p:pipe g:group) group
# expect warning: f: a | id does not use its input; the value of the step before is dropped

# ---
(import "default")
(def (f k:num) (if ((size main) <= k) lowbits))
(print f)

# expect stderr: (f k:num g:group) group

# ---
(import "default")
(def (f k:num) (if (size <= k) lowbits))

# expect error: f: size takes t:term? and gives num; its input here is a group: write the element, as in (size main) or (size (index i r))
