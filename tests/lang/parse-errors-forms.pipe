# Malformed forms and conditions are errors.
(import "default")
(parse "x") | main | nope

# expect error: unknown pass nope; did you mean note?

# ---
(import "default")
(parse "x") | main | (if minimal a | b)

# expect error: unknown pass a

# ---
(import "default")
(parse "x") | main | (union rewrite | unshift)

# expect error: group a pipeline argument of union in parentheses: (union ... (a | b))

# ---
(import "default")
(parse "x") | main | (relate)

# expect error: relate takes 2 arguments; | gives the last: (relate sub:pipe t:term) term

# ---
(import "default")
(parse "x") | main | relate

# expect error: relate needs parentheses: (relate ...); (relate sub:pipe t:term) term

# ---
(import "default")
(parse "x") | main | (fix many id)

# expect error: unknown name many in an expression; did you mean any?

# ---
(import "default")
(parse "x") | main | (if nope id)

# expect error: unknown name nope in an expression

# ---
(import "default")
(parse "x") | main | (off nope)

# expect error: unknown off name nope

# ---
(import "default")
(parse "x") | main | seq

# expect error: seq needs parentheses: (seq ...); (seq p:pipe... g:group) group

# ---
(import "default")
(parse "x") | main | (retry minimal id)

# expect error: retry takes 4 arguments; | gives the last: (retry c:group->num a:pipe b:pipe g:group) group

# ---
(import "default")
(parse "x") | main | rewrite)

# expect error: unexpected ) after the pipeline

# ---
(import "default")
(parse "x") | main | seq(rewrite,polish)

# expect error: unexpected character ',' in pipeline
