# Pipelines that give a number: steps on the input then a number, binding the caller's group variables, noted by smallest, skipped past the limit.
(import "default")
num_type = u32
sub = (parse "(x | y) - (x & y)")
(def (c1) main | (if ((rewrite | main | size) < size) rewrite))
sub | c1 | (save r) | (print "steps on the input, then a number:" r)
(def (c2) main | (if ((rewrite | main | size) > size) rewrite))
sub | c2 | (save r) | (print "(rewrite | main | size) > size:" r)
(def (c3) main | split_runs = (rewrite | main | size) | (if (split_runs < size) rewrite))
sub | c3 | (save r) | (print "an assignment's right side:" r)
(def (c4) main | (if ((t = rewrite | size) > 0) (seq t)))
sub | c4 | (save r) | (print "its steps bind the caller's group variables:" r)
(def (c5) main | rewrite | (save t) | none | (if (((main t) | size) > 0) (seq t)))
sub | c5 | (save r) | (print "starting with a value:" r)
(def (c6) main | (filter ((rewrite | main | size) < size)))
sub | c6 | (save r) | (print "on each element alone:" r)
(def (c7) main | (fix ((rewrite | main | size) - 2) id))
sub | c7 | (save r) | (print "a count:" r)
(def (f8) rewrite | main | size)
(def (c8) main | (if (f8 < size) rewrite))
sub | c8 | (save r) | (print "a function that gives a number from steps:" r)
(def (f9 g:group) g | rewrite | main | size)
(def (c9) main | (if (f9 < size) rewrite))
sub | c9 | (save r) | (print "with its input written as a parameter:" r)
(def (f10) (save t) | main | size)
(def (c10) main | rewrite | (save t) | none | (if (f10 == 0) (seq t)))
sub | c10 | (save r) | (print "a run of its own: its own group variables:" r)
(def (c11) main | (save s) | (smallest split_runs = (rewrite | main | size) | (seq s)))
sub | c11 | (save r) | (print "smallest notes its steps:" r)
(def (c12) main | (save s) | (smallest split_runs = f8 | (seq s)))
sub | c12 | (save r) | (print "but not those of a function's body:" r)
(def (c13) main | time_limit = 0 | split_runs = (rewrite | main | size) | time_limit = none | (if (split_runs == size) rewrite))
sub | c13 | (save r) | (print "past the limit its steps are skipped:" r)

# expect stderr: steps on the input, then a number: (x ^ y)
# expect stderr: (rewrite | main | size) > size: ((x | y) - (x & y))
# expect stderr: an assignment's right side: (x ^ y)
# expect stderr: its steps bind the caller's group variables: (x ^ y)
# expect stderr: starting with a value: (x ^ y)
# expect stderr: on each element alone: ((x | y) - (x & y))
# expect stderr: a count: ((x | y) - (x & y))
# expect stderr: a function that gives a number from steps: (x ^ y)
# expect stderr: with its input written as a parameter: (x ^ y)
# expect stderr: a run of its own: its own group variables: (x ^ y)
# expect stderr: smallest notes its steps: (x ^ y), ((x | y) - (x & y))
# expect stderr: but not those of a function's body: ((x | y) - (x & y))
# expect stderr: past the limit its steps are skipped: (x ^ y)
# expect warning: f10: group variable t is bound and never read
# expect warning: c13: time_limit is assigned again before anything reads it
# expect value: group [(Xor (Var "x") (Var "y"))]
