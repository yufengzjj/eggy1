(import "default")
num_type = u32
x = (parse "x - y")
m = (parse "x * (x * y)")
m | main | (print (mul + 0) ((mul >= 1) + (vars == 2) * 4))
x | main | (print !3 !!3 (2 && 5) (0 || 7) (vars * (mixed || 1)))
m | main | (if mul none) | (save r) | (print "a number holds where it is not 0:" r)
x | main | (if mul none) | (save r) | (print "(if mul none):" r)
x | main | (fix (mul < 1) rewrite) | (filter (size == 5)) | (save r) | (print "a comparison counts as 1:" r)

