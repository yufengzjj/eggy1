# Wrong assignments and old forms are errors that name the form to write.
(import "default")
(parse "x") | main | (if (size = 3) id)

# expect error: an assignment is a step; compare with ==

# ---
(import "default")
(parse "x") | main | (filter (vars = 2 || mul > 1))

# expect error: an assignment is a step; compare with ==

# ---
(import "default")
(parse "x") | main | (if size = 3 id)

# expect error: an assignment is a step; compare with ==

# ---
(import "default")
(parse "x") | main | (fix n = 3 id)

# expect error: an assignment is a step; compare with ==

# ---
(import "default")
(parse "x") | main | size = 1

# expect error: size is computed from the group and cannot be assigned: (size t:term?) num

# ---
(import "default")
(parse "x") | main | mixed = 1

# expect error: mixed is computed from the group and cannot be assigned: (mixed t:term?) num

# ---
(import "default")
(parse "x") | main | minimal = 1

# expect error: minimal is a condition and cannot be assigned; the setting is prove_minimal

# ---
(import "default")
(parse "x") | main | relate = none

# expect error: relate is a switch: assign it 0 (off) or 1 (on)

# ---
(import "default")
(parse "x") | main | split_runs = on

# expect error: unknown name on in an expression; known: size vars depth mul bitconst arith_in_bit shift div (same ...) (any ...) (all ...) (opaque ...) minimal mixed (rebuilds ...) moved was_cut input tiny fits_split used_wide used_clustered few_rewrites replaceable abstracted no_leaves wide const_bitwise cofactor and the variables

# ---
(import "default")
(parse "x") | main | (if nope id)

# expect error: unknown name nope in an expression; known: size vars depth mul bitconst arith_in_bit shift div (same ...) (any ...) (all ...) (opaque ...) minimal mixed (rebuilds ...) moved was_cut input tiny fits_split used_wide used_clustered few_rewrites replaceable abstracted no_leaves wide const_bitwise cofactor and the variables

# ---
(import "default")
(parse "x") | main | (if same id)

# expect error: same needs parentheses: (same ...); (same r:term? t:term) num

# ---
(import "default")
(parse "x") | main | split_runs = 18446744073709551615

# expect error: number too large: 18446744073709551615

# ---
(import "default")
(parse "x") | main | split_runs =

# expect error: expected an expression, found the end

# ---
(import "default")
(parse "x") | main | (with rewrites=8 semi_leaves=2 rewrite)

# expect error: (with KEY=VALUE ... p) is no longer read: write (KEY = VALUE | ... | p), as in (rewrites = 8 | semi_leaves = 2 | rewrite); with's bit_splits=N is bit_split_budget = N

# ---
(import "default")
(parse "x") | main | rewrite | (with bit_splits=2 rewrite)

# expect error: (with KEY=VALUE ... p) is no longer read: write (KEY = VALUE | ... | p), as in (rewrites = 8 | semi_leaves = 2 | rewrite); with's bit_splits=N is bit_split_budget = N

# ---
(import "default")
(parse "x") | main | with

# expect error: (with KEY=VALUE ... p) is no longer read: write (KEY = VALUE | ... | p), as in (rewrites = 8 | semi_leaves = 2 | rewrite); with's bit_splits=N is bit_split_budget = N

# ---
(import "default")
(parse "x") | main | (time-limit 500) | rewrite

# expect error: (time-limit N) is no longer read: write time_limit = N, or time_limit = none for no limit

# ---
(import "default")
(parse "x") | main | rewrite | time-limit

# expect error: (time-limit N) is no longer read: write time_limit = N, or time_limit = none for no limit

# ---
(import "default")
(parse "x") | main | (if true id)

# expect error: true is no longer a condition: write 1, or (any 1) for true only on a group that is not empty

# ---
(import "default")
(parse "x") | main | (filter (true && mixed))

# expect error: true is no longer a condition: write 1, or (any 1) for true only on a group that is not empty

# ---
(import "default")
(parse "x") | main | split_runs = size-mul-x

# expect error: unknown name x in an expression; known: size vars depth mul bitconst arith_in_bit shift div (same ...) (any ...) (all ...) (opaque ...) minimal mixed (rebuilds ...) moved was_cut input tiny fits_split used_wide used_clustered few_rewrites replaceable abstracted no_leaves wide const_bitwise cofactor and the variables (size-mul-x reads as size - mul - x: names use _, not -)

# ---
(import "default")
(parse "x") | main | tfunc-whole

# expect error: unexpected - after the pipeline (tfunc-whole reads as tfunc - whole: names use _, not -; write tfunc_whole)

# ---
(import "default")
(parse "x") | main | split_runs = size-mul | tfunc-whole

# expect error: unexpected - after the pipeline (tfunc-whole reads as tfunc - whole: names use _, not -; write tfunc_whole)

# ---
(import "default")
(parse "x") | main | (if (prove-minimal) id)

# expect error: unknown name prove in an expression; known: size vars depth mul bitconst arith_in_bit shift div (same ...) (any ...) (all ...) (opaque ...) minimal mixed (rebuilds ...) moved was_cut input tiny fits_split used_wide used_clustered few_rewrites replaceable abstracted no_leaves wide const_bitwise cofactor and the variables (prove-minimal reads as prove - minimal: names use _, not -; write prove_minimal)

# ---
(import "default")
(parse "x") | main | t = u + 1

# expect error: unknown name u in an expression; known: size vars depth mul bitconst arith_in_bit shift div (same ...) (any ...) (all ...) (opaque ...) minimal mixed (rebuilds ...) moved was_cut input tiny fits_split used_wide used_clustered few_rewrites replaceable abstracted no_leaves wide const_bitwise cofactor and the variables

# ---
(import "default")
(parse "x") | main | t = (u)

# expect error: unknown name u in an expression; known: size vars depth mul bitconst arith_in_bit shift div (same ...) (any ...) (all ...) (opaque ...) minimal mixed (rebuilds ...) moved was_cut input tiny fits_split used_wide used_clustered few_rewrites replaceable abstracted no_leaves wide const_bitwise cofactor and the variables

# ---
(import "default")
(parse "x") | main | keep = rewrite

# expect error: keep is a variable that holds a number, so it cannot be bound to a group: rewrite gives a group

# ---
(import "default")
(parse "x") | main | (save keep)

# expect error: keep is a variable that holds a number, so it cannot name a group variable

# ---
(import "default")
(parse "x") | main | (if (same (main relate)) id)

# expect error: relate is a variable that holds a number, so it cannot name a group variable

# ---
(import "default")
(parse "x") | main | rewrite = id

# expect error: rewrite is a function and cannot be assigned: (rewrite g:group) group

# ---
(import "default")
(parse "x") | main | size = id

# expect error: size is computed from the group and cannot be assigned: (size t:term?) num

# ---
(import "default")
(parse "x") | main | t = rewrite = 1

# expect error: rewrite is a function and cannot be assigned: (rewrite g:group) group

# ---
(import "default")
(let g lowbits)
(parse "x") | main | g = id

# expect error: g is defined by let or def @inline and cannot be assigned
