(parse "x") | main | extern

# expect error: extern declarations are only read from src/builtins.pipe

# ---
(import "default")
(parse "x") | main | (extern (x g:group) group)

# expect error: extern declarations are only read from src/builtins.pipe

# ---
(import "default")
(parse "x") | main | rewrite = 1

# expect error: rewrite is a function and cannot be assigned: (rewrite g:group) group

# ---
(import "default")
(parse "x") | main | relate

# expect error: relate needs parentheses: (relate ...); (relate sub:pipe t:term) term

# ---
(import "default")
(parse "x") | main | same = 1

# expect error: same is computed from the group and cannot be assigned: (same r:term? t:term) num

