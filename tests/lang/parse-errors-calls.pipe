# Calls are checked against the signatures; the errors name them.
(import "default")
(parse "x") | main | (filter (size vars))

# expect error: size takes t:term?; vars is a group — write (main vars)

# ---
(import "default")
(parse "x") | main | (if egglog id)

# expect error: egglog gives a group, not a number: (egglog label:name? g:group) group; an expression reads variables and number functions

# ---
(import "default")
(parse "x") | main | (if (best 1 id) id)

# expect error: best gives a group, not a number: (best k:num p:pipe... g:group) group; an expression reads variables and number functions

# ---
(import "default")
(parse "x") | main | (if mixed)

# expect error: if takes 3 or 4 arguments; | gives the last: (if c:group->num a:pipe b:pipe? g:group) group

# ---
(import "default")
(parse "x") | main | (if mixed id id id)

# expect error: if takes 3 or 4 arguments; | gives the last: (if c:group->num a:pipe b:pipe? g:group) group

# ---
(import "default")
(parse "x") | main | (retry mixed id)

# expect error: retry takes 4 arguments; | gives the last: (retry c:group->num a:pipe b:pipe g:group) group

# ---
(import "default")
(parse "x") | main | (fix 3)

# expect error: fix takes 3 arguments; | gives the last: (fix n:num p:pipe g:group) group

# ---
(import "default")
(parse "x") | main | (fix)

# expect error: fix takes 3 arguments; | gives the last: (fix n:num p:pipe g:group) group

# ---
(import "default")
(parse "x") | main | (seq)

# expect error: seq takes 2 or more arguments; | gives the last: (seq p:pipe... g:group) group

# ---
(import "default")
(parse "x") | main | (best 1)

# expect error: best takes 3 or more arguments; | gives the last: (best k:num p:pipe... g:group) group

# ---
(import "default")
(parse "x") | main | (save t 1)

# expect error: save takes 2 arguments; | gives the last: (save r:group g:group) group

# ---
(import "default")
(parse "x") | main | (save)

# expect error: save takes 2 arguments; | gives the last: (save r:group g:group) group

# ---
(import "default")
(parse "x") | main | (tag)

# expect error: tag takes 3 arguments; | gives the last: (tag n:name p:pipe g:group) group

# ---
(import "default")
(parse "x") | main | (lowbits x)

# expect error: lowbits takes 1 argument; | gives the last: (lowbits t:term) term

# ---
(import "default")
(parse "x") | main | (id 1)

# expect error: id takes 1 argument; | gives the last: (id g:group) group

# ---
(import "default")
(parse "x") | main | (print)

# expect error: print takes 1 or more arguments: (print x:any...)

# ---
(import "default")
(parse "x") | main | rewrite | size | rewrite

# expect error: size gives num; rewrite takes g:group

# ---
(import "default")
(parse "x") | main | (load t)

# expect error: unknown pass load

# ---
(import "default")
(parse "x") | main | fix

# expect error: fix needs parentheses: (fix ...); (fix n:num p:pipe g:group) group

# ---
(import "default")
(parse "x") | main | (if any id)

# expect error: any needs parentheses: (any ...); (any c:term->num g:group) num

# ---
(import "default")
(parse "x") | main | (if (same) id)

# expect error: same takes 2 arguments; | gives the last: (same r:term? t:term) num

# ---
(import "default")
(parse "x") | main | (if (same t 1) id)

# expect error: same takes r:term?; t is a group — write (main t)

# ---
(import "default")
(parse "x") | main | (if (size t) id)

# expect error: size takes t:term?; t is a group — write (main t)

# ---
(import "default")
(parse "x") | main | (if (size (rewrite)) id)

# expect error: size takes t:term?; (rewrite) is a group — write (main (rewrite))

# ---
(import "default")
(parse "x") | main | (if (minimal (main t)) id)

# expect error: minimal takes g:group; (main t) is term?, not a group

