(parse "x") | main | (if (same t 1) id)

# expect error: same takes r:term?; t is a group — write (main t)

# ---
(import "default")
(parse "x") | main | (if (size t) id)

# expect error: size takes t:term?; t is a group — write (main t)

# ---
(import "default")
(parse "x") | main | (if (size (rewrite)) id)

# expect error: size takes t:term?; (rewrite) is a group — write (main (rewrite))

# ---
(import "default")
(parse "x") | main | (if (minimal (main t)) id)

# expect error: minimal takes g:group; (main t) is term?, not a group

