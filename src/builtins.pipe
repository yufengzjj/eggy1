# The built-in functions of the pipeline language (docs/pipe-language.md), read before
# src/default.pipe. Each is implemented in Rust; this file declares its signature:
#
#   (extern [@ATTR ...] (NAME PARAM:TYPE ... INPUT:TYPE) RESULT)
#
# Types: num (a number), term (one candidate), term? (one candidate or none: a result, or
# a parameter of a function that gives a number, written as (main g) or (index i g); a
# group is never taken as a term), group (a list of candidates), name (a stats or origin name, or a note register),
# text (a string literal "...", with \" and \\ the only escapes), any (a value only
# formatted, as print does: a number, a text, a name, candidates as infix, a function as
# its signature; only as a last parameter any...), and functions A->B (A->B->C is
# A->(B->C)); pipe is group->group, a pipeline run inside the function. As a parameter,
# num is an expression evaluated once at the call; term->num and group->num are written
# as an expression too, evaluated on each candidate or on the group the function gives
# it; group is a group variable, written as its name.
# `TYPE...` is one or more, `TYPE?` may be left out. The last parameter is the input, which
# a call may leave out to take the step's. How a function is called follows from its input
# and result:
#   group -> group  on the whole list
#   term -> term    on each candidate; an unchanged result keeps the candidate
#   term -> term?   on each candidate; no result drops it (an alternative)
#   term -> group   on the main candidate; the result replaces the list
#   term -> num     on the main candidate; 0 without candidates
#   group -> num    on the whole list; 0 without candidates
#   term? -> num    on the candidate; 0 for none
#   group -> term?  on the whole list; the candidate picked, or none, replacing it
#   text -> group   the candidates read from the text (parse)
#   term? -> text   on the candidate; the empty text for none (show)
#   no input        an operator, on the input of the expression it is in
# @pipe: the last parameter, the input, is filled in by `|` (`a | (f x)` is `(f x a)`), so
# it can be a step; every built-in function but an operator and parse has it.
# An operator (a name such as + or <=) has no input: all its operands are written. Only its
# last parameter may be group->num..., operands it evaluates on its own input only while
# the result is still open (&& and || stop at the first that decides it).
# @timed: past the time limit a call is skipped and gives its input, which makes the run
# cut (with the switch cut on) and counts in time_limit/skipped; a function without it runs
# as usual. The same holds for a def that carries it.
# @simplify_only: only in `pipeline`, since only a simplify run has an e-graph.
# @uncounted (with @timed): its skip neither makes the run cut nor counts in time_limit/skipped.
# @switch: a pass over one term with a switch of its name, on until `(off NAME)` or
# `NAME = 0` turns it off (also off=NAME); the Rust code lists them in sched::INNER, with
# the switches of steps inside passes (semi_shapes, poly_masked, ...), which default.pipe
# defines.
# The comment line right before a declaration is its description.

# Combinators and forms with arguments.

# Each pipeline in turn on the candidates of the one before; a scope (also written a | b).
(extern @pipe (seq p:pipe... g:group) group)
# Every pipeline on the same input, their candidates in order, repeats dropped.
(extern @pipe @timed (union p:pipe... g:group) group)
# Every pipeline on the same input, then the k smallest of their candidates, at least 1.
(extern @pipe @timed (best k:num p:pipe... g:group) group)
# The first result that is not empty and differs from the input, else the input.
(extern @pipe @timed (first p:pipe... g:group) group)
# p repeated at most n times while the main candidate changes.
(extern @pipe @timed (fix n:num p:pipe g:group) group)
# a where c holds for the input, else b (id when left out).
(extern @pipe @timed (if c:group->num a:pipe b:pipe? g:group) group)
# a, and where c holds for its result, b on the same input, taken when no larger.
(extern @pipe @timed (retry c:group->num a:pipe b:pipe g:group) group)
# p, with the first strictly smaller candidate a step inside gave put first.
(extern @pipe @timed (smallest p:pipe g:group) group)
# p on one shared context of memos; a scope.
(extern @pipe @timed (scope p:pipe g:group) group)
# Each candidate that is a linear region rebuilt by p with its leaves rewritten, else its operands rewritten.
(extern @pipe @timed (regions p:pipe g:group) group)
# p, then rewrite again on its main candidate where it changed an arithmetic leaf of a bitwise operation.
(extern @pipe @timed (again p:pipe g:group) group)
# p timed as n/run; a changed main candidate is counted in n/won and gets origin n.
(extern @pipe @timed (tag n:name p:pipe g:group) group)
# p with origin n on every candidate, timed as pre/n/made (a pre-pass candidate, cand).
(extern @pipe @timed (origin n:name p:pipe g:group) group)
# p taken only when its main candidate is smaller than the input's, with origin n.
(extern @pipe @timed (smaller n:name p:pipe g:group) group)
# p repeated while a smaller inside takes a result, until n are taken.
(extern @pipe @timed (wins n:num p:pipe g:group) group)
# The candidates c holds for, each taken alone.
(extern @pipe (filter c:term->num g:group) group)
# Binds the group variable r to the candidates (r = id).
(extern @pipe (save r:group g:group) group)
# The candidates of the group variable r; none when it is unbound.
(extern @pipe (load r:group g:group) group)
# Counts the candidates for stats against the main one of the group variable r.
(extern @pipe (label r:group g:group) group)
# Opens the note register r, empty; note registers are not group variables.
(extern @pipe (clear r:name g:group) group)
# Keeps the first smallest candidate in the newest open r when strictly smaller than the one there.
(extern @pipe @timed @uncounted (note r:name g:group) group)
# Closes the newest open r: the input, with its candidate put first when strictly smaller than the main one.
(extern @pipe (take_min r:name g:group) group)
# The candidates unchanged when c is not 0; else the run ends with the error msg.
(extern @pipe (assert c:num msg:text g:group) group)
# The candidates unchanged, after the values x written to stderr, separated by spaces.
(extern @pipe (print x:any... g:group) group)

# Passes over the whole list.

# The candidates unchanged.
(extern @pipe (id g:group) group)
# No candidates.
(extern @pipe (none g:group) group)
# The pre-pass of the main candidate: the main rebuild, then those to union with it.
(extern @pipe @timed (prepass t:term) group)
# One egglog round on all candidates unioned: its extraction, timed as egglog/label.
(extern @pipe @timed @simplify_only (egglog label:name? g:group) group)
# The first candidate proved minimal, else the input.
(extern @pipe @timed (take_minimal g:group) group)
# The polish pipeline on the candidate, kept when smaller.
(extern @pipe @timed (polish t:term) term)
# The main candidate printed as infix and read back.
(extern @pipe @timed @simplify_only (reprint t:term) group)
# The pipeline function on the candidates, as a run of its own, whose steps the time limit skips.
(extern @pipe (pipeline g:group) group)
# The end of a simplification: counts final/ORIGIN of the main candidate, the gains of the forms in it, and time/cut.
(extern @pipe (settle g:group) group)
# No candidates once the rewrites budget is used up, else the input.
(extern @pipe (within g:group) group)
# The end of the pre-pass: counts the kept candidates and gives them origins pre/NAME.
(extern @pipe (pre_done g:group) group)

# Texts.

# The expression s, infix or an egglog term, read in the type num_type: one candidate.
(extern (parse s:text) group)
# The candidate as infix, its constants written as the type num_type prints them; empty for none.
(extern @pipe (show t:term?) text)

# Passes over one term.

# Known-bits reasoning: bitwise operations on known bits as additions, low bits cut.
(extern @pipe @switch @timed (lowbits t:term) term)
# Shifts written as masks, so regions become semi-linear.
(extern @pipe @switch @timed (unshift t:term) term)
# The whole term replaced by a smaller T-function form.
(extern @pipe @switch @timed (tfunc_whole t:term) term)
# The rewrite pipeline, memoized.
(extern @pipe @timed (rewrite t:term) term)
# rewrite, counted apart.
(extern @pipe @timed (rewrite_top t:term) term)
# Each region of the term rebuilt in clusters of the leaves its terms use.
(extern @pipe @switch @timed (cluster_regions t:term) term)
# cluster_regions, counted apart.
(extern @pipe @timed (cluster_top t:term) term)
# Arithmetic leaves of bitwise operations replaced by placeholders and related to the region.
(extern @pipe @switch @timed (relate t:term) term)
# Subterms replaced by smaller T-function forms.
(extern @pipe @switch @timed (tfunc t:term) term)
# Operands of bitwise operations written alike, so regions share more leaves.
(extern @pipe @switch @timed (unify_operands t:term) term)
# Sums of two products joined back into one product.
(extern @pipe @switch @timed (recombine t:term) term)
# Constants of product factors cut below the other factor's trailing zeros.
(extern @pipe @switch @timed (cut_products t:term) term)
# 2^k*(a ^ K) + c written as (2^k*a) ^ (2^k*K + c).
(extern @pipe @switch @timed (shifted_xor t:term) term)
# The lowbits steps for rebuilt terms only, such as cut multipliers.
(extern @pipe @switch @timed (simplify_rebuilt t:term) term)
# The end of a pre-pass rebuild: recombine, cut_products, shifted_xor, then lowbits.
(extern @pipe @timed (finish t:term) term)
# Operands 2^k*a + c of bitwise operations split into high and low parts.
(extern @pipe @timed (halve t:term) term)
# Bitwise operations with constants abstracted to variables, rebuilt and put back.
(extern @pipe @timed (over_const_bitwise t:term) term)
# Shared bitwise subterms abstracted to variables, rebuilt and put back.
(extern @pipe @timed (over_shared_bitwise t:term) term)
# Products abstracted to variables, rebuilt and put back.
(extern @pipe @timed (over_products t:term) term)
# Rebuilds by cases on one bit of a variable, undoing selections.
(extern @pipe @timed (split_bits t:term) term)
# Additions of 0 and multiplications by 1 dropped.
(extern @pipe @timed (drop_identities t:term) term)
# One rebuild without relate: lowbits, unshift, rewrite, cluster_regions, tfunc.
(extern @pipe @timed (rebuild t:term) term)

# Alternatives: each gives no candidate when it finds no form.

# The simba pipeline on a linear region.
(extern @pipe @switch @timed (simba t:term) term?)
# One bitwise term per block of at most 3 leaves of the conjunction basis.
(extern @pipe @switch @timed (small_blocks t:term) term?)
# Block rebuild of a wide region.
(extern @pipe @switch @timed (wide_blocks t:term) term?)
# Polynomial MBA: expanded, reduced and factored.
(extern @pipe @switch @timed (poly_mba t:term) term?)
# The leaves the values do not depend on set to 0, then rewritten.
(extern @pipe @switch @timed (drop_unused t:term) term?)
# Terms grouped by the leaves they use, each group rebuilt.
(extern @pipe @switch @timed (clustered t:term) term?)
# One term peeled off and the rest rebuilt.
(extern @pipe @switch @timed (peel t:term) term?)
# peel on the clustered form.
(extern @pipe @switch @timed (peel_clustered t:term) term?)
# Bit-by-bit rebuild of a region with constant masks.
(extern @pipe @switch @timed (semi_linear t:term) term?)
# Rebuild from the region's values on {0,1}^n.
(extern @pipe @switch @timed (rebuild_values t:term) term?)
# A common multiple c*(v_1 + ... + v_k) of close coefficients pulled out.
(extern @pipe @switch @timed (common_multiple t:term) term?)
# Small multiples of zero relations between leaves added, then rebuilt.
(extern @pipe @switch @timed (related_leaves t:term) term?)
# The whole region as one bitwise term.
(extern @pipe @switch @timed (one_wide_term t:term) term?)

# Polish passes, used in the polish pipeline.

# Complements pushed inward.
(extern @pipe @timed (polish_push_not t:term) term)
# Pairs of leaves rebuilt together with the constants.
(extern @pipe @timed (polish_join_constants t:term) term)
# Leaves moved between linear groups.
(extern @pipe @timed (polish_join_linear t:term) term)
# over_const_bitwise as a polish pass.
(extern @pipe @timed (polish_over_const_bitwise t:term) term)
# over_shared_bitwise as a polish pass.
(extern @pipe @timed (polish_over_shared_bitwise t:term) term)
# over_products as a polish pass.
(extern @pipe @timed (polish_over_products t:term) term)
# recombine, skipped where a product selects by one bit.
(extern @pipe @timed (polish_recombine t:term) term)
# Rebuilds by cases on variable shift amounts.
(extern @pipe @timed (polish_shift_cases t:term) term)
# Bitwise parts written as g(A) op h(B).
(extern @pipe @timed (polish_decompose t:term) term)
# Terms of one coefficient summed under it.
(extern @pipe @timed (polish_factor t:term) term)

# Number functions: features of the main candidate.

# The node count; (size (main r)) of the main candidate of the group variable r.
(extern @pipe (size t:term?) num)
# The number of variables.
(extern @pipe (vars t:term?) num)
# The depth of the tree.
(extern @pipe (depth t:term?) num)
# The number of products.
(extern @pipe (mul t:term?) num)
# The number of bitwise operations with a constant operand.
(extern @pipe (bitconst t:term?) num)
# The number of arithmetic operations under a bitwise one.
(extern @pipe (arith_in_bit t:term?) num)
# The number of shifts.
(extern @pipe (shift t:term?) num)
# The number of divisions.
(extern @pipe (div t:term?) num)

# Number functions that give 1 or 0.

# 1 when the candidate is r, as in (same (main r)); 0 when r is none.
(extern @pipe (same r:term? t:term) num)
# 1 when c holds for some candidate alone.
(extern @pipe (any c:term->num g:group) num)
# 1 when there are candidates and c holds for each alone.
(extern @pipe (all c:term->num g:group) num)
# A shift, division or mulhi, and a rebuild larger than tiny_size (runs prepass).
(extern @pipe (opaque t:term?) num)
# Some candidate is proved minimal (with prove_minimal on).
(extern @pipe (minimal g:group) num)
# Arithmetic or a constant directly under a bitwise operation.
(extern @pipe (mixed t:term?) num)
# The pre-pass changes it (runs prepass).
(extern @pipe (rebuilds t:term?) num)
# The last fix stopped at its count with the main candidate still changing.
(extern @pipe (moved g:group) num)
# A step of the program was skipped past the time limit with the switch cut on.
(extern @pipe (was_cut g:group) num)
# It is the input of the run.
(extern @pipe (input t:term?) num)
# At most tiny_size nodes.
(extern @pipe (tiny t:term?) num)
# At most split_size nodes.
(extern @pipe (fits_split t:term?) num)
# wide_blocks gave a kept form in the passes that made some candidate.
(extern @pipe (used_wide g:group) num)
# clustered gave a kept form in the passes that made some candidate.
(extern @pipe (used_clustered g:group) num)
# The passes that made it made at most unclustered_after uncached rewrite calls.
(extern @pipe (few_rewrites t:term?) num)
# The whole term has a smaller T-function form.
(extern @pipe (replaceable t:term?) num)
# It comes from a rebuild with abstracted subterms.
(extern @pipe (abstracted t:term?) num)
# It is a linear region without leaves.
(extern @pipe (no_leaves t:term?) num)
# It is a linear region of more than max_leaves leaves.
(extern @pipe (wide t:term?) num)
# It has a bitwise operation with a constant operand.
(extern @pipe (const_bitwise t:term?) num)
# The run rebuilds a linear cofactor of poly_mba.
(extern @pipe (cofactor g:group) num)

# Candidates of a group, as an argument a function takes as term?.

# The main candidate; none without candidates.
(extern @pipe (main g:group) term?)
# The candidate at position i, from 0; none past the last or for i none.
(extern @pipe (index i:num g:group) term?)

# Operators, written infix as in a + b (! before its operand) and evaluated on the input of
# the expression they are in. Arithmetic takes none as +infinity: + and * give none on
# overflow or a none operand, - stops at 0 (n - none is 0), / gives none for a 0 divisor and
# 0 for a none one. A comparison or !, &&, || gives 1 or 0.

# a plus b.
(extern (+ a:num b:num) num)
# a minus b, at least 0.
(extern (- a:num b:num) num)
# a times b.
(extern (* a:num b:num) num)
# a divided by b, rounded down.
(extern (/ a:num b:num) num)
# 1 when a is less than b.
(extern (< a:num b:num) num)
# 1 when a is at most b.
(extern (<= a:num b:num) num)
# 1 when a is greater than b.
(extern (> a:num b:num) num)
# 1 when a is at least b.
(extern (>= a:num b:num) num)
# 1 when a equals b.
(extern (== a:num b:num) num)
# 1 when a differs from b.
(extern (!= a:num b:num) num)
# 1 when a and each b are not 0; each b is evaluated only while all before are not 0.
(extern (&& a:num b:group->num...) num)
# 1 when a or some b is not 0; each b is evaluated only while all before are 0.
(extern (|| a:num b:group->num...) num)
# 1 when a is 0.
(extern (! a:num) num)
