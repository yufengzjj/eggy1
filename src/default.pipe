# The library of the simplification (docs/pipe-language.md), which a program reads with
# (import "default"): the global variables and their default values, the pipelines the
# passes are given and the function `simplify`. It holds only definitions: forms `(let ...)`
# and `(def ...)`, which may span lines, and lines `NAME = VALUE`, each defining a variable
# with the value it has from the import on. A `def` without parameters can be called before
# its definition in this file, and a later item of a program may define it again (`--passes
# prepass=P`), which every call then runs. How the Rust code uses a variable it reads (a switch,
# a budget, the deadline, a cache size) is in its list of them (`rust_vars`).

# Settings of the simplification.
keep = 2
extra = 2
printed = 2
rerun_input = 1
prove_minimal = 1
match_limit = 64
ban_length = 3
cut = 0
relate_parts = 1

# Switches of steps inside passes (the passes themselves are switches of their extern
# @switch): the sources of `semi_linear`'s forms and `poly_mba`'s masked expansion.
semi_grouped = 1
semi_peel_grouped = 1
semi_shapes = 1
semi_pairs = 1
semi_peel_shapes = 0
semi_split = 1
semi_scaled = 1
semi_bit_split = 1
semi_short_consts = 1
poly_masked = 1

# The pre-pass terms `cand` builds, by origin name (`--passes pre=a,b` sets these).
pre_unified = 1
pre_no_wide = 1
pre_split_bits = 1
pre_halve_first = 1
pre_over_products = 1
pre_over_const_bitwise = 1
pre_over_shared_bitwise = 1
pre_halve_input = 1
pre_unclustered = 1

# Every variable is none until assigned, and a definition as none here keeps a value the
# caller set before the program: the budgets and the deadline until a pipeline binds them,
# `restarts` and `iter_limit` until the program sets them (`-m`, `-i`), `num_type` (read as
# i64) and `trace` (off) likewise (`-n`, `--trace`).
rewrites = none
bit_split_budget = none
time_limit = none
restarts = none
iter_limit = none
num_type = none
trace = none

# Limits of the passes.
unclustered_relate_leaves = 10
unclustered_rewrites = 256
unclustered_after = 1024
unified_rewrites = 128
related_rebuilds = 8
related = 4
bit_splits = 4
cand_bit_splits = 8
splits = 4
split_depth = 2
split_runs = 16
split_size = 64
split_max_unknown_bits = 2
block_leaves = 12
block_combos = 32768
block_max_block = 3
block_descent_rounds = 4
block_spread_points = 8
cluster_depth = 2
poly_builds = 512
poly_branch_monos = 128
polish_rewrites = 2000
polish_wins = 8

# Sizes of the linear regions rebuilt.
tiny_size = 3
max_leaves = 6
max_wide_leaves = 16
semi_leaves = max_leaves
relate_leaves = max_wide_leaves

# `lowbits`.
lowbits_max_bits = 18
lowbits_max_context_bits = 18
lowbits_narrow_context_bits = 12
lowbits_max_try = 256
lowbits_max_values = 4
lowbits_max_product_bits = 4
lowbits_budget = 67108864
lowbits_wide_budget = 8388608
lowbits_max_low_rebuild = 64
lowbits_refine_bits = 2
lowbits_max_refine_bits = 12
lowbits_refine_budget = 4194304
lowbits_max_factor_terms = 4

# `poly_mba`.
poly_max_monos = 4096
poly_monos_per_node = 4
poly_factor_tries = 3
poly_max_factor_monos = 64
poly_max_factor_vars = 12
poly_max_pivots = 4
poly_max_roots = 16
poly_max_factor_steps = 4096
poly_max_solutions = 8
poly_max_shifted = 4
poly_max_shifted_monos = 4
poly_shifted_rest_ratio = 2
poly_max_atoms = 4
poly_max_masked_monos = 16
poly_masked_monos_ratio = 2
poly_max_masked_size = 20

# The rebuilds of linear regions and the shortest bitwise expressions.
common_multiple_min = 4
common_multiple_tries = 2
overlap_max_values = 4
overlap_max_choices = 16
overlap_max_terms = 3
decompose_max_vars = 5
decompose_min_free_size = 10
decompose_max_free_classes = 4
decompose_fill_max_vars = 3
decompose_xor_max_shared = 2
related_leaves_max_arith = 4
relate_max_written_out = 2
relate_max_free_product = 20
relate_max_parts = 8
relate_wide_max_percent = 90
unify_operands_max_leaves = 8
memo_contexts = 4

# Wide regions, `wide_blocks` and the bitwise expressions with free constants.
used_leaves_budget = 33554432
peel_min_size = 16
peel_spread_points = 16
wide_blocks_max_term_leaves = 10
wide_blocks_max_block = 10
wide_blocks_steps = 4096
wide_blocks_max_tables = 4096
wide_blocks_max_wide_tables = 16
wide_blocks_max_functions = 64
wide_blocks_cache_size = 4096
wide_blocks_descent_rounds = 4
wide_blocks_min_ratio = 2
shapes_max_size = 15
pairs_max_groups = 8
pairs_budget = 500000
pairs_max_size = 12
pairs_max_scales = 12
pairs_max_carries = 4096

# Semi-linear rebuilds.
semi_split_max_combos = 64
semi_half_flips = 2
semi_max_merges = 16
semi_max_code_groups = 4

# `polish`.
join_constants_max_leaves = 3
join_constants_max_sets = 10
join_linear_max_groups = 12
join_linear_near_slack = 4
join_linear_near_moves = 3
join_linear_max_near_groups = 8
shift_cases_depth = 2
shift_cases_max_size = 64
shift_cases_amounts = 2

# T-function replacement and proofs (`tfunc`, also `lowbits`), and the minimality proofs.
tfunc_max_vars = 3
tfunc_max_size = 7
tfunc_points = 24
tfunc_max_try = 256
tfunc_max_carries = 64
tfunc_max_states = 512
tfunc_max_factor = 255
minimal_points = 64
minimal_lanes = 16
minimal_budget = 2097152
minimal_max_vars = 3
minimal_max_size_4bit = 7
minimal_max_size_8bit = 5

# The largest values of the limits the Rust code sizes tables, shifts or bit masks by; none
# is more. `simplify` checks them when it starts, so a larger value the program assigned ends
# the run with the error before a pass reads it; a pipeline that assigns one of them is not
# checked.
(let check_limits
  (assert (block_max_block <= 5) "block_max_block is at most 5")
  | (assert (max_leaves <= 6) "max_leaves is at most 6")
  | (assert (max_wide_leaves <= 64) "max_wide_leaves is at most 64")
  | (assert (lowbits_max_bits <= 63) "lowbits_max_bits is at most 63")
  | (assert (lowbits_max_context_bits <= 63) "lowbits_max_context_bits is at most 63")
  | (assert (lowbits_max_refine_bits <= 63) "lowbits_max_refine_bits is at most 63")
  | (assert (overlap_max_terms <= 63) "overlap_max_terms is at most 63")
  | (assert (unify_operands_max_leaves <= 63) "unify_operands_max_leaves is at most 63")
  | (assert (decompose_max_free_classes <= 63) "decompose_max_free_classes is at most 63")
  | (assert (wide_blocks_max_term_leaves <= 63) "wide_blocks_max_term_leaves is at most 63")
  | (assert (wide_blocks_max_block <= 63) "wide_blocks_max_block is at most 63")
  | (assert (shapes_max_size <= 15) "shapes_max_size is at most 15")
  | (assert (tfunc_max_vars <= 4) "tfunc_max_vars is at most 4")
  | (assert (tfunc_points <= 24) "tfunc_points is at most 24")
  | (assert (tfunc_max_carries <= 128) "tfunc_max_carries is at most 128")
  | (assert (minimal_lanes <= 16) "minimal_lanes is at most 16")
  | (assert (minimal_max_vars <= 31) "minimal_max_vars is at most 31"))

# A pre-pass term with origin n, built when `enabled` (a `pre_NAME` switch, or 1) is not
# 0, on its own budget of bit_split pairs.
(def @inline @timed (cand enabled:num n p) (if enabled (origin n (bit_split_budget = cand_bit_splits | p)) none))


# A later round: the pre-pass rebuilds, then their extraction, or the one proved minimal.
(let later main | (prepass prepass_steps) | (if minimal take_minimal (egglog later)))

# The first round. Saturating a large input is most of the run time and rarely beats its
# rebuild, so the input joins only inputs with shifts, division or mulhi whose rebuild is
# not tiny (`opaque`), or a rerun when the result still mixes arithmetic or constants
# into bitwise operations.
(let first_round
  (if (opaque prepass_steps main)
    ((union id (main | (prepass prepass_steps))) | (if minimal take_minimal (egglog first)))
    (retry (rerun_input && (mixed main) && !minimal)
      (main | (prepass prepass_steps) | (if minimal take_minimal (egglog first)))
      ((union id (main | (prepass prepass_steps))) | (egglog rerun_input)))))

# The pipeline `simplify` runs: the restart rounds while the extraction changes, extra ones
# while the pre-pass still rebuilds it, polish, all keeping the smallest form seen (the
# extraction prefers fewer non-constant nodes, results are compared by node count); then
# the same from the printed result, kept when smaller. With `--passes time_limit=MS` the
# run stops starting passes MS ms after it starts, keeps the smallest form so far and, with
# `cut` on, counts as cut.
(def (pipeline)
  cut = 1
  | (smallest
    (fix 1 first_round)
    | (if moved (fix (restarts - 1) later))
    | (if moved (fix extra (if (rebuilds prepass_steps main) later)))
    | (polish polish_steps))
  | (if (printed && !(input main))
      (tag rerun_printed
        (best 1 id
          (main
           | reprint
           | (smallest
               (fix 1 first_round)
               | (if moved (fix (printed - 1) later))
               | (polish polish_steps)))))))

# The simplification of a group: the limits checked, `pipeline`, the input itself where that
# gives an empty group, and the stats of the result settled.
(def (simplify g:group) g | check_limits | pipeline | (if !(any 1) g) | settle)

# A rebuild of a term: the whole term replaced by a T-function lookup, or its
# regions rewritten, clustered, related and its subterms replaced (`~(y - 1)` replaced
# before the rebuild would become `-y`, a leaf the rebuild no longer relates to `y - 1`).
(let rebuild_main (first tfunc_whole ((rewrite_top rewrite) | (cluster_top rewrite) | (relate rewrite) | tfunc)))
(let rebuild_plain (first tfunc_whole ((rewrite_top rewrite) | (cluster_top rewrite) | tfunc)))

# The passes the pre-pass turns off for inputs where paired `off=` runs without them lost
# nothing: `poly_mba` without products of non-constant factors, `lowbits` without those,
# shifts and bitwise operations with a constant operand, and `small_blocks` with more than
# 3 products and no shift.
(let gates
  (if ((mul main) < 1) (off poly_mba))
  | (if ((mul main) < 1 && (shift main) < 1 && (bitconst main) < 1) (off lowbits))
  | (if ((mul main) >= 4 && (shift main) < 1) (off small_blocks)))

# The pre-pass (`prepass`), on one run (`scope`). Group variables: `t0` the input, `t` with
# low bits and shifts rewritten, `r` the first rebuild, `n` the rebuild without `wide_blocks`,
# `f`/`b` the terms finished, `u` the rebuild without clusters, `m` the ones kept.
(def (prepass_steps)
  (scope
    (save t0) | gates | lowbits | unshift | (save t)
    | (cand 1 first rebuild_main)
    # Unified operands let the regions around them share leaves, but the rebuild of the
    # input as written is sometimes smaller; dropped once it needs `unified_rewrites` rewrites.
    | (best 1 id
        (cand pre_unified unified
          t | unify_operands | (filter !(same (main t)))
          | (rewrites = unified_rewrites
             | (first tfunc_whole (rewrite | within | (cluster_regions rewrite) | (relate rewrite) | within | tfunc)))))
    | (save r)
    | (union id
        # A region rebuilt by `wide_blocks` is smaller there, but the other rebuilds can
        # leave subterms the abstracted rebuilds share across terms; a larger one unioned
        # beside the first rebuild made the rules finish worse as often as better.
        (cand pre_no_wide no_wide
          (if used_wide
            (t | ((off wide_blocks) | rebuild_main) | (save n) | (filter (size < (size (main r)))))
            none))
        (cand 1 no_wide_abstracted
          n
          | ((off wide_blocks) | (union (over_const_bitwise (rebuild rewrite)) (over_shared_bitwise (rebuild rewrite))))
          | (filter (size < (size (main r)) && size <= (size (main n)) * 3 / 4)))
        (cand pre_split_bits split_bits (if (fits_split main) ((split_bits (rebuild rewrite)) | (filter !(same (main r)))) none))
        (cand pre_halve_first halve_first (halve rewrite) | (filter !(same (main r))) | rebuild_plain)
        (cand pre_over_products over_products (over_products (rebuild rewrite)) | (filter !(same (main r))))
        (cand pre_over_const_bitwise over_const_bitwise (over_const_bitwise (rebuild rewrite)) | (filter !(same (main r))))
        (cand pre_over_shared_bitwise over_shared_bitwise (over_shared_bitwise (rebuild rewrite)) | (filter !(same (main r))))
        # Halving the whole input can give semi-linear regions that are slow to search.
        (cand pre_halve_input halve_input
          (semi_leaves = 2
           | (if (tiny main) none (t | (halve rewrite) | (filter !(same (main t))) | rebuild_plain)))))
    # A form from abstracted subterms only a little smaller than the first rebuild, or
    # larger, made the rules finish worse at least as often as better (Ensia, LLVM Pluto).
    | (finish rewrite) | (save f) | (filter (!abstracted || size <= (size (main f)) * 3 / 4)) | (save b) | (label b)
    # A region rebuilt in clusters is smaller there but can leave the rules a worse start
    # than rebuilding it whole.
    | (cand pre_unclustered unclustered
        (if (used_clustered && (few_rewrites main))
          (t
           | (if !(replaceable main)
               (relate_leaves = unclustered_relate_leaves
                | relate_parts = 0
                | rewrites = unclustered_rewrites
                | clustered = 0
                | rewrite | within | (relate rewrite) | within | tfunc | (finish rewrite) | drop_identities)
               none))
          none))
    # An equal-size one can take the extraction from the first rebuild with nothing gained.
    | (label b) | (save u) | (b | (best keep id)) | (save m)
    | (union
        (u | (filter (size < (size (main m)))))
        m
        (u | (filter (size > (size (main m)) && size < (size (main t0))))))
    | pre_done))

# The final polish (`polish`), on one term: the polish passes in turn, each kept when
# smaller, repeated while one is, until `polish_wins` are; on one run whose `rewrite` calls are
# limited. `join_linear` rewrites every pair of leaf groups many times, and semi-linear groups
# of many leaves take seconds there. `polish=a,b,...` in --passes writes the same for other
# passes.
(def (polish_steps)
  (scope
    rewrites = polish_rewrites
    | (wins polish_wins
        (smaller polish_push_not polish_push_not | drop_identities)
        | (smaller polish_join_constants (polish_join_constants rewrite) | drop_identities)
        | (smaller polish_join_linear (semi_leaves = 2 | (polish_join_linear rewrite) | drop_identities))
        | (smaller polish_over_const_bitwise (polish_over_const_bitwise (rebuild rewrite)) | drop_identities)
        | (smaller polish_over_shared_bitwise (polish_over_shared_bitwise (rebuild rewrite)) | drop_identities)
        | (smaller polish_over_products (polish_over_products (rebuild rewrite)) | drop_identities)
        | (smaller polish_recombine (polish_recombine rewrite) | drop_identities)
        | (smaller polish_shift_cases (polish_shift_cases (rebuild rewrite)) | drop_identities)
        | (smaller polish_decompose polish_decompose | drop_identities)
        | (smaller polish_factor polish_factor | drop_identities))))

# The rebuild of one term, memoized, which the passes inside it run on subterms: a linear
# region rebuilt by the smallest of `simba`, `small_blocks` and `wide_blocks`, or else its
# operands rewritten; `poly_mba` taken instead when strictly smaller.
(def (rewrite) (memo rewrite (again rewrite (best 1 (regions rewrite (best 1 (simba simba_steps) small_blocks wide_blocks)) (poly_mba rewrite simba_steps)))))

# The rebuild of one linear region, the `simba` pass. Past `max_leaves` leaves: the
# smallest of the region with unused leaves dropped, clustered, and peeled (only when no
# leaf is unused: then the rewrite of the dropped form peels), the region itself or else
# its clustered form, which a region too large to evaluate needs. Otherwise the
# semi-linear rebuild, or the smallest rebuild from its values, kept when smaller than
# the region; `one_wide_term` costs more than it gains on the cofactors of `poly_mba`.
(def (simba_steps)
  (if (no_leaves main) none
    (if (wide main)
      ((save in)
       | (best 1
           ((drop_unused rewrite) | (save d))
           ((clustered rewrite) | (save c))
           (d
            | (if (any 1) none
                (in | (first (peel simba_steps) (c | (peel_clustered simba_steps))) | (filter !(same (main in))))))))
      ((save in)
       | (if (const_bitwise main)
           (best 1 (semi_linear rewrite))
           (best 1 rebuild_values common_multiple related_leaves (if !cofactor one_wide_term none)))
       | (filter (size < (size (main in))))))))
